{
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Write(**/.env*)",
      "Read(**/*.pem)",
      "Write(**/*.pem)",
      "Read(**/*.key)",
      "Write(**/*.key)",
      "Read(**/credentials.json)",
      "Write(**/credentials.json)",
      "Read(**/secrets.json)",
      "Write(**/secrets.json)"
    ]
  }
}
